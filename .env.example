# Required production secrets and Telegram identity.
POSTGRES_PASSWORD=
DATABASE_URL=
# The agent and its workers connect as osinara_app; migrations keep DATABASE_URL (the owner).
APP_DATABASE_URL=
WORKFLOW_POSTGRES_URL=
INVITATION_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Guards the internal drain, approval-sweep and workflow flow routes; must differ from the webhook secret.
AGENT_INTERNAL_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: the bot's other active @usernames, comma-separated. Mentions, replies and /command@name by any of them
# reach the bot; links use TELEGRAM_BOT_USERNAME.
TELEGRAM_BOT_USERNAME_ALIASES=
# Optional installation identity. Empty values use Шуша and its case forms (Шуши, Шуше, Шушу, Шушей, Shusha).
TELEGRAM_AGENT_NAME=Шуша
# JSON array; [] disables aliases, while an empty value selects defaults for the name.
TELEGRAM_AGENT_ALIASES=
# Voice messages. The default config/agent-model-providers.json enables Groq Whisper, so the agent does not
# start without this key; set "voice": {"enabled": false} in that file to run without voice.
GROQ_API_KEY=
# Only for "voice": {"provider": "gigaam"} with the service from infra/gigaam.
GIGAAM_API_KEY=
CLI_PROXY_API_KEY=
# Active direct provider key (DeepSeek by default: https://platform.deepseek.com/api_keys) or the exact
# internal CLIProxy bearer key.
MODEL_API_KEY=
# manual (default in compose.yaml) or upstream: whether the bot proposes releases published upstream.
OSINARA_SOFTWARE_UPDATES=manual

# Optional integrations; paired credentials must be supplied together when enabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PUBLIC_BASE_URL=
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Optional image generation (generate_image): Cloudflare Workers AI needs both values, NeuralDeep is the fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
NEURALDEEP_IMAGE_API_KEY=
# Explicit OpenRouter image provider takes priority; both values are required.
OPENROUTER_IMAGE_API_KEY=
OPENROUTER_IMAGE_MODEL=
# Separate opt-in for Seedance 2.5, USD 30 per person/month across chats.
OPENROUTER_VIDEO_API_KEY=

# Каталог продуктов для инструмента grocery_cart. Официальный MCP-сервер ВкусВилла читается без
# авторизации: бот собирает корзину, а заказ, адрес доставки и оплата остаются в аккаунте человека.
# Без этой переменной инструмента нет ни в одном режиме.
GROCERY_MCP_URL=https://mcp.vkusvill.ru/mcp

# Настройки под размер установки. Пустое значение или отсутствие переменной даёт значение по
# умолчанию (одна семья на одном ядре); число вне границ или не целое останавливает запуск
# (AGENT_RUNTIME_TUNING_INVALID). Шаги Workflow ограничивает WORKFLOW_POSTGRES_WORKER_CONCURRENCY в compose.
# Сколько чатов бот обслуживает одновременно: каждый drain держит свой чат до конца хода (1..100, по умолчанию 3).
TELEGRAM_INGRESS_MAX_CONCURRENT_DRAINS=
# Сколько нажатий кнопок обрабатывается одновременно рядом с обычными ходами (1..100, по умолчанию 2).
TELEGRAM_INGRESS_MAX_CONCURRENT_CALLBACK_DRAINS=
# Сколько тихих проверок памяти идёт одновременно: они делят воркеры Workflow с живыми ходами,
# на одном ядре хватает одной-двух (1..100, по умолчанию 10).
MEMORY_REVIEW_MAX_IN_FLIGHT=
# Сколько полос проверки памяти диспетчер разбирает за одну минуту; остальные ждут следующей (1..10000, по умолчанию 200).
MEMORY_REVIEW_MATERIALIZE_LANE_LIMIT=
# Личный чат: голова серии берётся в работу после такой тишины в мс, чтобы серия сообщений дошла
# целиком; окно платится на каждом личном сообщении (0..60000, по умолчанию 2000).
TELEGRAM_PRIVATE_BURST_QUIET_MS=
# Потолок ожидания серии в мс при непрерывном потоке; не меньше тишины выше (0..300000, по умолчанию 20000).
TELEGRAM_PRIVATE_BURST_MAX_WAIT_MS=
# Песочницы: сколько контейнеров работает одновременно (1..200, по умолчанию 10); при достижении
# потолка останавливается самый давно молчавший, занятые не трогаются.
SANDBOX_MAX_RUNNING=
# Через сколько мс простоя контейнер песочницы останавливается; холодный старт стоит ~3 с на
# следующей команде (60000..86400000, по умолчанию 1800000, то есть 30 минут).
SANDBOX_IDLE_TIMEOUT_MS=
